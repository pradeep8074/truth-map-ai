# TRUTHMAP AI — Environment Configuration Template
# Copy this file to .env and configure the necessary keys

# Google Gemini API Configuration (optional for heuristic fallback)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-flash-lite-latest

# External Search Provider Configuration
# Set to 'tavily' and provide TAVILY_API_KEY to enable autonomous source discovery.
# Set to 'none' for manual URL and document triage mode.
SEARCH_PROVIDER=none
TAVILY_API_KEY=your_tavily_api_key_here
SEARCH_TIMEOUT_SECONDS=10
SEARCH_MAX_RESULTS=5
