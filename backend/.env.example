# ==============================================================================
# TRUTHMAP AI Backend — Environment Variables Template
# Copy this file to .env and fill in your secrets.
# NEVER commit the active .env file to public version control.
# ==============================================================================

# Google Gemini API Configuration
# Get your API key from https://aistudio.google.com/app/apikey
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE
GEMINI_MODEL=gemini-2.0-flash

# Application Server Port (Render sets this dynamically)
PORT=8000

# CORS Allowed Frontend Origins (Comma-separated list of deployed domains)
# Example: https://truthmap-ai.vercel.app,http://localhost:5173
FRONTEND_ORIGINS=https://truthmap-ai.vercel.app,http://localhost:5173

# Database & Persistent Storage (Render Persistent Disk: /var/data)
# Leave blank for local default (backend/data/truthmap.db)
DATABASE_PATH=/var/data/truthmap.db
UPLOAD_DIR=/var/data/uploads

# External Search Provider for Component 10 Verification Navigator
# Options: "none" (deterministic manual gateway), "duckduckgo", "tavily"
SEARCH_PROVIDER=none
TAVILY_API_KEY=
SEARCH_TIMEOUT_SECONDS=10
SEARCH_MAX_RESULTS=5
